# Copy to .env.local for local development. Never commit real values.

# Supabase project that stores demo requests and contact messages.
# Server-side only. Without these the forms show a fallback booking link.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email notification for each new request (see README, "Notifications").
NOTIFY_WEBHOOK_SECRET=
RESEND_API_KEY=
NOTIFY_FROM=

# Optional. Base URL of the product app. When set, the site shows
# "Log in" in the navigation and "Sign up" as a secondary link.
NEXT_PUBLIC_APP_URL=

# Optional. Set to "true" to show the pricing section. Default: hidden.
NEXT_PUBLIC_SHOW_PRICING=
